generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              Int           @id @default(autoincrement())
  rut             String        @unique
  nombre          String
  email           String        @unique
  rol_enum        String
  centro_salud_id Int?
  password        String        @default("123456")
  consolidados    Consolidado[]
  centro_salud    CentroSalud?  @relation(fields: [centro_salud_id], references: [id])

  @@index([centro_salud_id], map: "Usuario_centro_salud_id_fkey")
}

model CentroSalud {
  id                 Int           @id @default(autoincrement())
  nombre             String
  porcentaje_zona    Decimal       @default(0.00) @db.Decimal(5, 2)
  porcentaje_dificil Decimal       @default(0.00) @db.Decimal(5, 2)
  parent_id          Int?
  parent             CentroSalud?  @relation("CentroDependientes", fields: [parent_id], references: [id])
  dependientes       CentroSalud[] @relation("CentroDependientes")
  consolidados       Consolidado[]
  funcionarios       Funcionario[]
  usuarios           Usuario[]

  @@index([parent_id], map: "CentroSalud_parent_id_fkey")
}

model Funcionario {
  rut                   String                  @id
  nombre_completo       String
  profesion_enum        String
  categoria_aps         String?
  nivel_aps             Int?
  jornada_horas         Int?
  centro_salud_id       Int?
  fecha_nacimiento      DateTime?
  activo                Boolean                 @default(true)
  asignaciones          AsignacionEspecial[]
  AsignacionFuncionario AsignacionFuncionario[]
  atrasos               Atrasos[]
  ausentismos           Ausentismo[]
  contratos             Contrato[]
  centro_salud          CentroSalud?            @relation(fields: [centro_salud_id], references: [id])
  horas_extras          HorasExtras[]
  liquidaciones         LiquidacionMensual[]
  procedimientos        Procedimientos[]
  turnos                TurnosUrgencia[]
  viaticos              Viaticos[]

  @@index([centro_salud_id], map: "Funcionario_centro_salud_id_fkey")
}

model EscalaSueldo {
  id          Int     @id @default(autoincrement())
  categoria   String
  nivel       Int
  sueldo_base Decimal @db.Decimal(12, 2)

  @@unique([categoria, nivel])
}

model Programa {
  id             Int           @id @default(autoincrement())
  nombre         String
  categoria_enum String
  horas_extras   HorasExtras[]
}

model Periodo {
  id                            Int                             @id @default(autoincrement())
  mes                           Int
  anio                          Int
  estado                        String
  consolidados                  Consolidado[]
  liquidaciones                 LiquidacionMensual[]
  VerificacionMensualAsignacion VerificacionMensualAsignacion[]
}

model Consolidado {
  id                       Int              @id @default(autoincrement())
  centro_salud_id          Int
  periodo_id               Int
  estado_actual_enum       String
  vb_control_interno       Boolean          @default(false)
  fecha_vb_control_interno DateTime?
  firma_vb_control_interno String?
  vb_finanzas              Boolean          @default(false)
  fecha_vb_finanzas        DateTime?
  firma_vb_finanzas        String?
  usuario_gestor_id        Int?
  url_respaldo             String?          @db.LongText
  reloj_data               Json?
  atrasos                  Atrasos[]
  centro_salud             CentroSalud      @relation(fields: [centro_salud_id], references: [id])
  periodo                  Periodo          @relation(fields: [periodo_id], references: [id])
  usuario_gestor           Usuario?         @relation(fields: [usuario_gestor_id], references: [id])
  horas_extras             HorasExtras[]
  procedimientos           Procedimientos[]
  turnos_urgencia          TurnosUrgencia[]
  viaticos                 Viaticos[]

  @@index([centro_salud_id], map: "Consolidado_centro_salud_id_fkey")
  @@index([periodo_id], map: "Consolidado_periodo_id_fkey")
  @@index([usuario_gestor_id], map: "Consolidado_usuario_gestor_id_fkey")
}

model HorasExtras {
  id               Int              @id @default(autoincrement())
  consolidado_id   Int
  funcionario_rut  String
  programa_id      Int
  cantidad_25      Decimal          @db.Decimal(10, 2)
  cantidad_50      Decimal          @db.Decimal(10, 2)
  monto_25         Decimal          @default(0.00) @db.Decimal(12, 2)
  monto_50         Decimal          @default(0.00) @db.Decimal(12, 2)
  estado_25        EstadoValidacion @default(PENDIENTE)
  estado_50        EstadoValidacion @default(PENDIENTE)
  fecha_inicio     DateTime
  fecha_termino    DateTime
  observaciones_25 String?
  observaciones_50 String?
  url_respaldo     String?          @db.LongText
  consolidado      Consolidado      @relation(fields: [consolidado_id], references: [id])
  funcionario      Funcionario      @relation(fields: [funcionario_rut], references: [rut])
  programa         Programa         @relation(fields: [programa_id], references: [id])

  @@index([consolidado_id], map: "HorasExtras_consolidado_id_fkey")
  @@index([funcionario_rut], map: "HorasExtras_funcionario_rut_fkey")
  @@index([programa_id], map: "HorasExtras_programa_id_fkey")
}

model TurnosUrgencia {
  id                    Int              @id @default(autoincrement())
  consolidado_id        Int
  funcionario_rut       String
  cant_turnos_habiles   Int
  cant_turnos_inhabiles Int
  fecha_inicio          DateTime
  fecha_termino         DateTime
  monto_calculado       Decimal          @db.Decimal(12, 2)
  estado                EstadoValidacion @default(PENDIENTE)
  valor_habil           Decimal?         @db.Decimal(12, 2)
  valor_inhabil         Decimal?         @db.Decimal(12, 2)
  url_respaldo          String?          @db.LongText
  consolidado           Consolidado      @relation(fields: [consolidado_id], references: [id])
  funcionario           Funcionario      @relation(fields: [funcionario_rut], references: [rut])

  @@index([consolidado_id], map: "TurnosUrgencia_consolidado_id_fkey")
  @@index([funcionario_rut], map: "TurnosUrgencia_funcionario_rut_fkey")
}

model Viaticos {
  id                Int              @id @default(autoincrement())
  consolidado_id    Int
  funcionario_rut   String
  tipo_destino      String
  fecha_inicio      DateTime
  fecha_termino     DateTime
  monto_calculado   Decimal          @db.Decimal(12, 2)
  estado            EstadoValidacion @default(PENDIENTE)
  justificacion     String?
  concepto          String?
  url_respaldo      String?          @db.LongText
  rendicion_pasajes Decimal          @default(0.00) @db.Decimal(12, 2)
  consolidado       Consolidado      @relation(fields: [consolidado_id], references: [id])
  funcionario       Funcionario      @relation(fields: [funcionario_rut], references: [rut])

  @@index([consolidado_id], map: "Viaticos_consolidado_id_fkey")
  @@index([funcionario_rut], map: "Viaticos_funcionario_rut_fkey")
}

model Atrasos {
  id               Int              @id @default(autoincrement())
  consolidado_id   Int
  funcionario_rut  String
  fecha_inicio     DateTime?
  fecha_termino    DateTime?
  tiempo_descuento String
  monto_descuento  Decimal          @default(0.00) @db.Decimal(12, 2)
  estado           EstadoValidacion @default(PENDIENTE)
  concepto         String?
  minutos          Int              @default(0)
  url_respaldo     String?          @db.LongText
  consolidado      Consolidado      @relation(fields: [consolidado_id], references: [id])
  funcionario      Funcionario      @relation(fields: [funcionario_rut], references: [rut])

  @@index([consolidado_id], map: "Atrasos_consolidado_id_fkey")
  @@index([funcionario_rut], map: "Atrasos_funcionario_rut_fkey")
}

model Procedimientos {
  id                   Int              @id @default(autoincrement())
  consolidado_id       Int
  funcionario_rut      String
  total_procedimientos Int
  fecha_inicio         DateTime
  fecha_termino        DateTime
  monto_calculado      Decimal          @db.Decimal(10, 2)
  estado               EstadoValidacion @default(PENDIENTE)
  url_respaldo         String?          @db.LongText
  consolidado          Consolidado      @relation(fields: [consolidado_id], references: [id])
  funcionario          Funcionario      @relation(fields: [funcionario_rut], references: [rut])

  @@index([consolidado_id], map: "Procedimientos_consolidado_id_fkey")
  @@index([funcionario_rut], map: "Procedimientos_funcionario_rut_fkey")
}

model HistorialAuditoria {
  id             Int      @id @default(autoincrement())
  tipo_modulo    String
  registro_id    Int
  usuario_nombre String
  campo_afectado String?
  valor_anterior String?
  valor_nuevo    String?
  fecha          DateTime @default(now())
}

model EscalaHorasExtras {
  id        Int     @id @default(autoincrement())
  categoria String
  nivel     Int
  valor_25  Decimal @db.Decimal(12, 2)
  valor_50  Decimal @db.Decimal(12, 2)
  anio      Int     @default(2026)

  @@unique([categoria, nivel, anio])
}

model LiquidacionMensual {
  id                   Int         @id @default(autoincrement())
  funcionario_rut      String
  periodo_id           Int
  sueldo_base          Decimal     @db.Decimal(12, 2)
  total_haberes        Decimal     @db.Decimal(12, 2)
  total_descuentos     Decimal     @db.Decimal(12, 2)
  monto_liquido        Decimal     @db.Decimal(12, 2)
  monto_he_pagado      Decimal     @default(0.00) @db.Decimal(12, 2)
  monto_atrasos_pagado Decimal     @default(0.00) @db.Decimal(12, 2)
  cantidad_he_25_real  Decimal     @default(0.00) @db.Decimal(10, 2)
  cantidad_he_50_real  Decimal     @default(0.00) @db.Decimal(10, 2)
  monto_viaticos_real  Decimal     @default(0.00) @db.Decimal(12, 2)
  minutos_atraso_real  Int         @default(0)
  detalle_json         Json
  fecha_importacion    DateTime    @default(now())
  funcionario          Funcionario @relation(fields: [funcionario_rut], references: [rut])
  periodo              Periodo     @relation(fields: [periodo_id], references: [id])

  @@unique([funcionario_rut, periodo_id])
  @@index([periodo_id], map: "LiquidacionMensual_periodo_id_fkey")
}

model Contrato {
  id              Int         @id @default(autoincrement())
  funcionario_rut String
  tipo_contrato   String
  fecha_inicio    DateTime
  fecha_termino   DateTime?
  cargo           String?
  jornada_horas   Int?
  estado          String
  funcionario     Funcionario @relation(fields: [funcionario_rut], references: [rut])

  @@index([funcionario_rut], map: "Contrato_funcionario_rut_fkey")
}

model Ausentismo {
  id                        Int              @id @default(autoincrement())
  funcionario_rut           String
  tipo_ausentismo           String
  fecha_inicio              DateTime
  fecha_termino             DateTime
  dias_habiles              Int
  descuento_aplicable       Boolean          @default(false)
  monto_descuento_calculado Decimal?         @db.Decimal(12, 2)
  estado_validacion         EstadoValidacion @default(PENDIENTE)
  funcionario               Funcionario      @relation(fields: [funcionario_rut], references: [rut])

  @@index([funcionario_rut], map: "Ausentismo_funcionario_rut_fkey")
}

model AsignacionEspecial {
  id                 Int              @id @default(autoincrement())
  funcionario_rut    String
  tipo_asignacion    String
  nro_resolucion     String
  fecha_inicio       DateTime
  fecha_termino      DateTime?
  monto_o_porcentaje Decimal          @db.Decimal(12, 2)
  estado_validacion  EstadoValidacion @default(PENDIENTE)
  funcionario        Funcionario      @relation(fields: [funcionario_rut], references: [rut])

  @@index([funcionario_rut], map: "AsignacionEspecial_funcionario_rut_fkey")
}

model CatalogoAsignacion {
  id           Int                     @id @default(autoincrement())
  nombre       String                  @unique
  estado       String                  @default("ACTIVO")
  asignaciones AsignacionFuncionario[]
}

model AsignacionFuncionario {
  id              Int                             @id @default(autoincrement())
  funcionario_rut String
  asignacion_id   Int
  tipo_calculo    String                          @default("MONTO_FIJO")
  valor           Decimal                         @db.Decimal(12, 2)
  fecha_inicio    DateTime
  fecha_termino   DateTime?
  num_resolucion  String?
  fecha_resolucion DateTime?
  estado          String                          @default("ACTIVO")
  catalogo        CatalogoAsignacion              @relation(fields: [asignacion_id], references: [id])
  funcionario     Funcionario                     @relation(fields: [funcionario_rut], references: [rut])
  verificaciones  VerificacionMensualAsignacion[]

  @@index([funcionario_rut], map: "AsigFunc_funcionario_rut_fkey")
  @@index([asignacion_id], map: "AsigFunc_asignacion_id_fkey")
}

model VerificacionMensualAsignacion {
  id                        Int                   @id @default(autoincrement())
  periodo_id                Int
  asignacion_funcionario_id Int
  estado_verificacion       String                @default("PENDIENTE")
  observaciones             String?               @db.LongText
  asignacion                AsignacionFuncionario @relation(fields: [asignacion_funcionario_id], references: [id])
  periodo                   Periodo               @relation(fields: [periodo_id], references: [id])

  @@unique([periodo_id, asignacion_funcionario_id])
  @@index([periodo_id], map: "VerifMensual_periodo_id_fkey")
  @@index([asignacion_funcionario_id], map: "VerifMensual_asignacion_id_fkey")
}

model Parametro {
  clave  String  @id
  valor  String
  modulo String?
}

enum EstadoValidacion {
  PENDIENTE
  APROBADO
  RECHAZADO
}
